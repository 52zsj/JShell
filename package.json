{
  "name": "jshell",
  "productName": "JShell",
  "version": "0.11.8",
  "private": true,
  "description": "JShell - 跨平台 SSH / 终端管理工作台",
  "author": {
    "name": "JShell",
    "email": "dev@jshell.local"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "meta": "node scripts/make-release-meta.mjs",
    "notes": "node scripts/write-release-notes.mjs",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./tests/register-ts.mjs --test-timeout=20000 --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:coverage": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-test-coverage --import ./tests/register-ts.mjs --test-timeout=20000 --test tests/*.test.mjs",
    "dist:mac": "npm run meta && npm run build && electron-builder --mac",
    "dist:win": "npm run meta && npm run build && electron-builder --win",
    "dist:linux": "npm run meta && npm run build && electron-builder --linux",
    "dist:all": "node scripts/build-all.mjs",
    "postinstall": "node scripts/fix-native-perms.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "measure:memory": "node scripts/measure-memory.mjs",
    "measure:startup": "node scripts/measure-startup.mjs",
    "notes:section": "node scripts/changelog-section.mjs",
    "release:tag": "node scripts/tag-release.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.1"
  }
}
